GROQ_API_KEY=your-key-goes-in-.env-not-here
# Optional: share cache, quotas and research jobs between servers (e.g. redis://localhost:6379/0)
REDIS_URL=
# Signs session cookies. At least 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Optional Google sign-in. Create an OAuth client in Google Cloud Console (type: Web application) and add the
# redirect URI below to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
